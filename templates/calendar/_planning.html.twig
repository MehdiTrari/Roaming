{% set calendarProperties = property is defined ? [property] : navProperties %}
{% set picker = propertyPicker|default(false) %}
{% set compact = compact|default(false) %}
{% set popoverId = 'stay-dates-' ~ (calendarProperties|first).slug|default('calendar') %}
{% set requestedSlug = app.request.query.all.slug|default('') %}
{% set selectedProperty = calendarProperties|filter(item => item.slug == requestedSlug)|first %}
<div data-controller="calendar" data-calendar-compact-value="{{ compact ? 'true' : 'false' }}" data-calendar-published-value="{{ booking_availability_enabled ? 'true' : 'false' }}" data-calendar-picker-value="{{ picker ? 'true' : 'false' }}" data-calendar-url-value="{{ calendarUrl }}" data-calendar-quote-url-value="{{ preview|default(false) ? path('api_availability_test') : path('api_availability') }}" class="roaming-calendar stay-calendar {{ compact ? 'property-booking-compact' : '' }} {{ picker ? 'availability-journey' : '' }} {{ picker and not selectedProperty ? 'is-choosing' : '' }}">
    {% if picker %}
        <section class="stay-property-picker" {% if selectedProperty %}hidden{% endif %} aria-labelledby="availability-choice-title">
            {% if calendarProperties|length %}{% include 'calendar/_property_explorer.html.twig' %}{% else %}<h2 id="availability-choice-title" tabindex="-1">{{ 'calendar.pick_property'|trans }}</h2><p>{{ 'home.no_properties'|trans }}</p>{% endif %}
        </section>
    {% endif %}
    <div class="stay-property-buttons {{ picker or calendarProperties|length == 1 ? 'd-none' : '' }}" role="group" aria-label="{{ 'calendar.property'|trans }}">
        {% for item in calendarProperties %}
            <button type="button" class="stay-property-button" data-calendar-target="propertyButton" data-action="calendar#selectProperty" data-slug="{{ item.slug }}" data-name="{{ item.title }}" data-capacity="{{ item.bookingCapacity }}" data-url="{{ preview|default(false) ? path('api_calendar_test', {slug: item.slug}) : path('api_property_availability', {slug: item.slug}) }}" aria-pressed="{{ loop.first ? 'true' : 'false' }}">
                <strong>{{ item.city }}</strong><span>{{ item.title }}</span>
            </button>
        {% endfor %}
    </div>
    <div data-calendar-target="stage" {% if picker and not selectedProperty %}hidden{% endif %}>
    {% if picker %}
        <header class="availability-selected-header">
            <h2 class="stay-property-name" data-calendar-target="propertyName" tabindex="-1">{{ selectedProperty.title|default('') }}</h2>
            <a class="btn availability-change-property" href="{{ path('app_calendar', {_locale: app.request.locale}) }}" data-booking-reset-property data-booking-clear-dates><span aria-hidden="true">←</span> {{ 'calendar.change_property'|trans }}</a>
        </header>
    {% endif %}
    {% set bookingProperty = selectedProperty ?: (not picker ? calendarProperties|first : null) %}
    {% if bookingProperty and bookingProperty.bookingCapacity < bookingProperty.travelers %}
        <p class="small property-muted"><a href="{{ path('app_contact', {_locale: app.request.locale}) }}">{{ 'listing.group_capacity_notice'|trans({'%guests%': bookingProperty.bookingCapacity}) }}</a></p>
    {% endif %}
    <div class="calendar-unavailable" data-calendar-target="notice" hidden>
        <h2 class="h4">{{ 'calendar.confirm'|trans }}</h2>
        <p>{{ 'calendar.closed_notice'|trans }}</p>
        <a class="btn btn-primary" href="{{ path('app_contact') }}">{{ 'calendar.contact'|trans }}</a>
        {% if app.environment == 'dev' %}
            <div class="calendar-dev-note"><p>{{ 'calendar.dev_notice'|trans }}</p><a href="{{ path('app_calendar_test') }}">{{ 'calendar.open_test'|trans }} →</a></div>
        {% endif %}
    </div>
    <div data-calendar-target="content">
        {% if not picker %}<p class="stay-property-name {{ compact ? 'visually-hidden' : '' }}" data-calendar-target="propertyName"></p>{% endif %}
        <form data-action="submit->calendar#quote">
            {% if compact %}
                <div class="compact-date-fields">
                    {% for part in ['arrival', 'departure'] %}
                    <button type="button" class="compact-date-trigger" data-calendar-target="dateTrigger" data-date-part="{{ part }}" data-action="calendar#openDates" aria-haspopup="dialog" aria-expanded="false" aria-controls="{{ popoverId }}"><span>{{ (part == 'arrival' ? 'home.arrival_date' : 'home.departure_date')|trans }}</span><strong data-date-label>{{ 'ui.choose_dates'|trans }}</strong></button>
                    {% endfor %}
                </div>
            {% endif %}
            <fieldset data-calendar-target="fields" disabled>
                <legend class="visually-hidden">{{ 'calendar.choose'|trans }}</legend>
                <div class="stay-selection-header">
                    <div class="stay-summary"><h2 data-calendar-target="summary"></h2><p data-calendar-target="selection" aria-live="polite"></p></div>
                    <div class="stay-date-inputs {{ compact ? 'visually-hidden' : '' }}">
                        <label>{{ 'home.arrival_date'|trans }}<input type="{{ compact ? 'hidden' : 'date' }}" name="arrivalDate" required data-calendar-target="arrival" data-action="input->calendar#changed"></label>
                        <label>{{ 'home.departure_date'|trans }}<input type="{{ compact ? 'hidden' : 'date' }}" name="departureDate" required data-calendar-target="departure" data-action="input->calendar#changed"></label>
                    </div>
                </div>
            </fieldset>
            {% if compact %}
            <dialog class="property-date-popover" id="{{ popoverId }}" data-calendar-target="popover" data-action="cancel->calendar#cancelDates click->calendar#outsideDates" aria-labelledby="{{ popoverId }}-title">
                <div class="search-popover-heading"><h3 id="{{ popoverId }}-title">{{ 'ui.stay_dates'|trans }}</h3><button type="button" class="search-popover-close" data-action="calendar#closeDates" aria-label="{{ 'ui.close'|trans }}">×</button></div>
                <p class="compact-date-hint" data-calendar-target="dateHint" aria-live="polite">{{ 'ui.date_hint'|trans }}</p>
            {% endif %}
            <div class="stay-month-navigation">
                <button class="calendar-nav-button" type="button" data-calendar-target="previous" data-action="calendar#previous" aria-label="{{ 'calendar.previous'|trans }}">‹</button>
                {% if compact %}<strong class="compact-month-label visually-hidden" data-calendar-target="monthLabel"></strong>{% else %}<button class="calendar-today-button" type="button" data-action="calendar#today">{{ 'calendar.today'|trans }}</button>{% endif %}
                <button class="calendar-nav-button" type="button" data-calendar-target="next" data-action="calendar#next" aria-label="{{ 'calendar.next'|trans }}">›</button>
            </div>
            <div class="calendar-fetch-surface" data-calendar-target="calendarSurface">
                <div class="stay-months" data-calendar-target="board" data-action="click->calendar#selectDate keydown->calendar#keyboard pointerover->calendar#previewRange pointerleave->calendar#clearRangePreview focusin->calendar#previewRange focusout->calendar#clearRangePreview"></div>
                {% include 'components/_calendar_loading.html.twig' only %}
            </div>
            <div class="stay-calendar-bottom">
                <p class="stay-legend"><span>{{ 'calendar.available'|trans }}</span><s>{{ 'calendar.unavailable'|trans }}</s><span>? {{ 'calendar.unverified'|trans }}</span><span>↗ {{ 'calendar.checkout_only'|trans }}</span></p>
            </div>
            {% if compact %}<div class="compact-date-actions"><button type="button" class="btn btn-primary" data-calendar-target="applyDates" data-action="calendar#closeDates">{{ 'ui.apply'|trans }}</button></div></dialog>{% endif %}
            <div class="stay-booking-controls">
                <label>{{ 'home.guests'|trans }}{% if compact %}<select class="form-select" name="guests" required data-calendar-target="guests" data-action="change->calendar#changed">{% for count in 1..(calendarProperties|first).bookingCapacity|default(20) %}<option value="{{ count }}">{{ count }}</option>{% endfor %}</select>{% else %}<input class="form-control" type="number" name="guests" min="1" max="{{ (calendarProperties|first).bookingCapacity|default(20) }}" value="2" required data-calendar-target="guests" data-action="input->calendar#changed">{% endif %}</label>
                <div class="stay-actions">
                    {% include 'components/_clear_dates.html.twig' with {planning: true} only %}
                    <button class="btn btn-primary" type="submit" data-calendar-target="submit" disabled>{{ 'calendar.quote'|trans }}</button>
                </div>
            </div>
            <p class="booking-search-status" data-calendar-target="progress" role="status" aria-live="polite"></p>
            <p class="booking-selection-feedback" data-calendar-target="feedback" role="status" aria-live="polite"></p>
            <p class="small text-muted mt-3">{{ 'calendar.quote_note'|trans }}</p>
            <div data-calendar-target="quote" class="stay-quote" aria-live="polite"></div>
        </form>
        <div class="stay-footer"><p class="calendar-status" data-calendar-target="status" role="status" aria-live="polite">{{ 'calendar.loading'|trans }}</p><a class="calendar-contact" href="{{ path('app_contact') }}">{{ 'calendar.contact'|trans }} →</a></div>
    </div>
    </div>
    <noscript><p>{{ 'calendar.confirm'|trans }}</p></noscript>
</div>
