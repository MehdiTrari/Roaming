{{ form_start(contactForm, {'attr': {'novalidate': 'novalidate', 'class': 'contact-form'}}) }}
    {% if contactForm.vars.errors|length %}<div class="alert alert-danger" role="alert">{{ form_errors(contactForm) }}</div>{% endif %}
    {% for name in ['name', 'email', 'phone', 'subject', 'message'] %}
        {% set field = attribute(contactForm, name) %}
        {% set invalid = field.vars.errors|length > 0 %}
        {% set errorId = field.vars.id ~ '_errors' %}
        {% set attributes = {class: 'form-control' ~ (invalid ? ' is-invalid' : ''), placeholder: ('ui.placeholder_' ~ name)|trans, 'aria-invalid': invalid ? 'true' : 'false', autocomplete: name == 'name' ? 'name' : name == 'email' ? 'email' : name == 'phone' ? 'tel' : 'off'} %}
        {% if invalid %}{% set attributes = attributes|merge({'aria-describedby': errorId}) %}{% endif %}
        {% if name == 'message' %}{% set attributes = attributes|merge({rows: 4}) %}{% endif %}
        <div class="mb-3">
            {{ form_label(field, 'ui.contact_' ~ name, {label_attr: {class: 'form-label small fw-bold'}}) }}
            {% if field.vars.required %}<span class="text-danger" aria-hidden="true">*</span>{% else %}<span class="text-muted small">({{ 'form.optional'|trans }})</span>{% endif %}
            {{ form_widget(field, {attr: attributes}) }}
            {% if invalid %}<div id="{{ errorId }}" class="invalid-feedback d-block" role="alert">{{ form_errors(field) }}</div>{% endif %}
        </div>
    {% endfor %}
    <div class="d-grid">{{ form_widget(contactForm.submit, {label: 'ui.send', attr: {class: 'btn btn-primary text-white fw-semibold no-hover-lift'}}) }}</div>
{{ form_end(contactForm) }}
