{% extends 'base.html.twig' %}

{% block title %}{{ 'contact.title'|trans }}{% endblock %}

{% block meta_description %}{{ 'seo.contact_description'|trans }}{% endblock %}

{% block structured_data %}
{{ parent() }}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": {{ 'contact.title'|trans|json_encode(15)|raw }},
    "description": {{ 'seo.contact_description'|trans|json_encode(15)|raw }},
    "url": {{ url('app_contact')|json_encode(15)|raw }},
    "mainEntity": {
        "@type": "Organization",
        "name": "Roaming Lille",
        "email": "contact@roamingfr.com",
        "telephone": "+33660344071"
    }
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": {{ 'menu.home'|trans|json_encode(15)|raw }},
            "item": {{ url('app_home')|json_encode(15)|raw }}
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": {{ 'contact.section_title'|trans|json_encode(15)|raw }},
            "item": {{ url('app_contact')|json_encode(15)|raw }}
        }
    ]
}
</script>
{% endblock %}

{% block body %}
<section class="py-5 bg-teal-fade" id="contact">
    <div class="container py-5">
        <div class="row gy-5">
            <div class="col-lg-6 reveal">
                <p class="text-teal fw-bold mb-2">{{ 'contact.section_title'|trans }}</p>
                <h1 class="display-5 fw-bold mb-3">{{ 'contact.hero_title'|trans }}</h1>
                <p class="lead text-muted mb-4">{{ 'contact.hero_description'|trans }}</p>
                <div class="card border-0 shadow-sm p-4 hover-lift">
                    <div class="card-body">
                        <p class="mb-2 text-muted">{{ 'ui.contact_email'|trans }}: <a class="text-teal text-decoration-none fw-bold" href="mailto:contact@roamingfr.com">contact@roamingfr.com</a></p>
                        <p class="mb-0 text-muted">{{ 'ui.contact_phone'|trans }}: <a class="text-teal text-decoration-none fw-bold" href="tel:+33660344071">+33 6 60 34 40 71</a></p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 reveal" style="transition-delay: 0.2s;">
                <div class="card border-0 shadow-sm p-4 hover-lift">
                    <div class="card-body">
                        {% include 'components/_contact_form.html.twig' %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
