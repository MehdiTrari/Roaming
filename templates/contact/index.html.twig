{% extends 'base.html.twig' %}

{% block title %}{{ 'contact.title'|trans }}{% endblock %}

{% block meta_description %}{{ 'seo.contact_description'|trans }}{% endblock %}

{% block structured_data %}
{{ parent() }}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": {{ 'contact.title'|trans|json_encode(15)|raw }},
    "description": {{ 'seo.contact_description'|trans|json_encode(15)|raw }},
    "url": {{ url('app_contact')|json_encode(15)|raw }},
    "mainEntity": {
        "@type": "Organization",
        "name": "Roaming Lille",
        "email": "contact@roamingfr.com",
        "telephone": "+33660344071"
    }
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": {{ 'menu.home'|trans|json_encode(15)|raw }},
            "item": {{ url('app_home')|json_encode(15)|raw }}
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": {{ 'contact.section_title'|trans|json_encode(15)|raw }},
            "item": {{ url('app_contact')|json_encode(15)|raw }}
        }
    ]
}
</script>
{% endblock %}

{% block body %}
{% set illustratedProperties = navProperties|default([])|filter(p => p.images|length > 0)|slice(0, 2) %}
<section class="hospitality-contact" id="contact">
    <div class="container">
        <div class="hospitality-contact-layout">
            <div class="hospitality-contact-intro reveal">
                <p class="hospitality-eyebrow">{{ 'contact.section_title'|trans }}</p>
                <h1 class="hospitality-page-title">{{ 'contact.hero_title'|trans }}</h1>
                <p class="hospitality-intro-copy">{{ 'contact.hero_description'|trans }}</p>
                <dl class="hospitality-contact-details">
                    <div>
                        <dt>{{ 'ui.contact_email'|trans }}</dt>
                        <dd><a href="mailto:contact@roamingfr.com">contact@roamingfr.com <span aria-hidden="true">↗</span></a></dd>
                    </div>
                    <div>
                        <dt>{{ 'ui.contact_phone'|trans }}</dt>
                        <dd><a href="tel:+33660344071">+33 6 60 34 40 71 <span aria-hidden="true">↗</span></a></dd>
                    </div>
                </dl>
                {% if illustratedProperties %}
                <div class="hospitality-contact-stays" aria-label="{{ 'home.featured_properties'|trans }}">
                    {% for property in illustratedProperties %}
                    <a class="hospitality-stay-preview" href="{{ path('app_property_show', {slug: property.slug}) }}">
                        {% include 'components/_picture.html.twig' with {filename: (property.images|first).filename, alt: '', sizes: '(min-width: 992px) 300px, 45vw'} only %}
                        <span><strong>{{ property.city }}</strong><span aria-hidden="true">↗</span></span>
                        <span class="visually-hidden">{{ property.title }}</span>
                    </a>
                    {% endfor %}
                </div>
                {% endif %}
            </div>
            <div class="hospitality-contact-form-panel reveal">
                <h2>{{ 'home.contact_title'|trans }}</h2>
                {% include 'components/_contact_form.html.twig' %}
            </div>
        </div>
    </div>
</section>
{% endblock %}
