{% extends 'base.html.twig' %}

{% block title %}{{ 'error.404.title'|trans|default('Page introuvable') }} — Roaming Lille{% endblock %}

{% block meta_description %}{{ 'error.404.meta'|trans|default('La page que vous recherchez n\'existe pas ou a été déplacée.') }}{% endblock %}

{% block robots %}noindex, follow{% endblock %}

{% block body %}
<section class="min-vh-75 d-flex align-items-center py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                {# Illustration 404 #}
                <div class="mb-4">
                    <div class="position-relative d-inline-block">
                        <span class="display-1 fw-bold text-teal opacity-25" style="font-size: clamp(7rem, 30vw, 12rem); line-height: 1;">404</span>
                        <div class="position-absolute top-50 start-50 translate-middle">
                            <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="currentColor" class="text-teal" viewBox="0 0 16 16">
                                <path d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4.5a.5.5 0 0 0 .5-.5v-4h2v4a.5.5 0 0 0 .5.5H14a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.354 1.146zM2.5 14V7.707l5.5-5.5 5.5 5.5V14H10v-4a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 0-.5.5v4H2.5z"/>
                            </svg>
                        </div>
                    </div>
                </div>

                {# Message principal #}
                <h1 class="h2 fw-bold mb-3">
                    {{ 'error.404.heading'|trans|default('Oups ! Cette page s\'est envolée...') }}
                </h1>
                <p class="lead text-muted mb-4">
                    {{ 'error.404.message'|trans|default('La page que vous cherchez n\'existe plus ou a été déplacée. Pas de panique, nous avons d\'autres belles découvertes pour vous !') }}
                </p>

                {# Boutons d'action #}
                <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center mb-5">
                    <a href="{{ path('app_home') }}" class="btn btn-primary btn-lg px-4 text-white">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="me-2" viewBox="0 0 16 16">
                            <path d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4.5a.5.5 0 0 0 .5-.5v-4h2v4a.5.5 0 0 0 .5.5H14a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.354 1.146zM2.5 14V7.707l5.5-5.5 5.5 5.5V14H10v-4a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 0-.5.5v4H2.5z"/>
                        </svg>
                        {{ 'error.404.home_button'|trans|default('Retour à l\'accueil') }}
                    </a>
                    <a href="{{ path('app_contact') }}" class="btn btn-outline-secondary btn-lg px-4">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="me-2" viewBox="0 0 16 16">
                            <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-4.708 2.825L15 11.105V5.383Zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741ZM1 11.105l4.708-2.897L1 5.383v5.722Z"/>
                        </svg>
                        {{ 'error.404.contact_button'|trans|default('Nous contacter') }}
                    </a>
                </div>

                {# Suggestions de propriétés #}
                {% if suggestedProperties is defined and suggestedProperties|length > 0 %}
                <div class="border-top pt-5">
                    <h2 class="h5 fw-semibold mb-4">
                        {{ 'error.404.suggestions_title'|trans|default('Découvrez nos logements') }}
                    </h2>
                    <div class="row g-4">
                        {% for property in suggestedProperties %}
                        <div class="col-md-4">
                            {% include 'components/_property_card.html.twig' with {property: property} %}
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</section>


{% endblock %}
