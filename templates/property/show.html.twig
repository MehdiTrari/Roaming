{% extends 'base.html.twig' %}

{% block title %}{{ property.title }} | Roaming Lille{% endblock %}

{% block meta_description %}{{ 'seo.property_description'|trans({'%title%': property.title, '%city%': property.city, '%bedrooms%': property.bedrooms, '%beds%': property.beds, '%bathrooms%': property.bathrooms, '%travelers%': property.travelers}) }}{% endblock %}

{% block meta_keywords %}{{ property.title }}, {{ property.city }}, location appartement {{ property.city }}, hébergement {{ property.city }}, Roaming Lille{% endblock %}

{% block og_type %}product{% endblock %}

{% block og_image %}{% if property.images|length > 0 %}{{ absolute_url(asset('uploads/' ~ property.images|first.filename)) }}{% else %}{{ parent() }}{% endif %}{% endblock %}

{% block structured_data %}
{{ parent() }}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "LodgingBusiness",
    "name": "{{ property.title }}",
    "description": "{{ property.about|default(property.description)|default('')|slice(0, 200)|e('js') }}",
    "url": "{{ url('app_property_show', {slug: property.slug}) }}",
    {% if property.images|length > 0 %}
    "image": [
        {% for image in property.images|slice(0, 5) %}
        "{{ absolute_url(asset('uploads/' ~ image.filename)) }}"{% if not loop.last %},{% endif %}
        {% endfor %}
    ],
    {% endif %}
    "address": {
        "@type": "PostalAddress",
        "addressLocality": "{{ property.city }}",
        "addressRegion": "Hauts-de-France",
        "addressCountry": "FR"
    },
    "amenityFeature": [
        {"@type": "LocationFeatureSpecification", "name": "Wi-Fi", "value": true},
        {"@type": "LocationFeatureSpecification", "name": "Self Check-in", "value": true}
    ],
    "numberOfRooms": {{ property.bedrooms }},
    "occupancy": {
        "@type": "QuantitativeValue",
        "maxValue": {{ property.travelers }}
    },
    "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+33660344071",
        "email": "contact@roamingfr.com",
        "contactType": "reservations"
    }{% if property.airbnbRating and property.airbnbReviewsCount %},
    "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "{{ property.airbnbRating }}",
        "bestRating": "5",
        "worstRating": "1",
        "ratingCount": "{{ property.airbnbReviewsCount }}",
        "reviewCount": "{{ property.airbnbReviewsCount }}"
    }{% endif %}
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "{{ 'menu.home'|trans }}",
            "item": "{{ url('app_home') }}"
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": "{{ 'menu.properties'|trans }}",
            "item": "{{ url('app_home') }}#properties"
        },
        {
            "@type": "ListItem",
            "position": 3,
            "name": "{{ property.title }}",
            "item": "{{ url('app_property_show', {slug: property.slug}) }}"
        }
    ]
}
</script>
{% endblock %}

{% block body %}
{% set locale = app.request.locale %}
<section class="bg-teal-fade py-5">
    <div class="container py-4 reveal">
        <div class="d-flex justify-content-between align-items-start gap-4 mb-5 flex-wrap">
            <div>
                <p class="text-teal fw-bold mb-1">{{ property.city }}</p>
                <h1 class="display-5 fw-bold text-dark mb-3">{{ property.title }}</h1>
                <div class="d-flex flex-wrap gap-2 text-muted small mb-3">
                    <span class="badge property-info-badge fw-normal p-2 hover-lift">👥 {{ property.travelers }} {{ 'property.travelers'|trans }}</span>
                    <span class="badge property-info-badge fw-normal p-2 hover-lift">🛏️ {{ property.bedrooms }} {{ 'property.bedrooms'|trans }}</span>
                    <span class="badge property-info-badge fw-normal p-2 hover-lift">🛌 {{ property.beds }} {{ 'property.beds'|trans }}</span>
                    <span class="badge property-info-badge fw-normal p-2 hover-lift">🛁 {{ property.bathrooms }} {{ 'property.baths'|trans }}</span>
                </div>
                
                {# Airbnb Badge #}
                {% if property.airbnbUrl %}
                <a href="https://{{ property.airbnbUrl }}" target="_blank" rel="noopener noreferrer" class="airbnb-badge badge fw-normal p-2 d-inline-flex align-items-center gap-2 text-decoration-none" title="{{ 'property.view_on_airbnb'|trans|default('Voir sur Airbnb') }}">
                    <img src="{{ asset('images/Airbnb-Logo.png') }}" alt="Airbnb" height="18" style="object-fit: contain;">
                    {% if property.airbnbRating %}
                    <span class="d-flex align-items-center gap-1">
                        <span class="rating-star">★</span>
                        <span class="fw-bold rating-value">{{ property.airbnbRating|number_format(2, ',') }}</span>
                    </span>
                    {% endif %}
                    {% if property.airbnbReviewsCount %}
                    <span class="small reviews-count">({{ property.airbnbReviewsCount }} {{ 'property.reviews'|trans|default('avis') }})</span>
                    {% endif %}
                </a>
                {% endif %}
            </div>
            <a href="{{ path('app_home') }}#top" class="btn btn-primary text-white fw-semibold px-4 hover-lift">{{ 'property.book_now'|trans }}</a>
        </div>

        <div class="row g-5">
            <div class="col-lg-8">
                {% if property.images|length > 0 %}
                <div id="propertyCarousel" class="carousel slide property-card-carousel mb-5 rounded-4 overflow-hidden shadow-sm hover-lift">
                    <div class="carousel-indicators">
                        {% for image in property.images %}
                            <button type="button" data-bs-target="#propertyCarousel" data-bs-slide-to="{{ loop.index0 }}" {% if loop.first %}class="active" aria-current="true"{% endif %} aria-label="Slide {{ loop.index }}"></button>
                        {% endfor %}
                    </div>
                    <div class="carousel-inner" style="aspect-ratio: 16/9;">
                        {% for image in property.images %}
                            <div class="carousel-item {% if loop.first %}active{% endif %} h-100">
                                <img src="{{ asset('uploads/' ~ image.filename) }}" class="d-block w-100 h-100 object-fit-cover" alt="{{ image.alt ?? property.title }}" loading="{% if loop.first %}eager{% else %}lazy{% endif %}">
                            </div>
                        {% endfor %}
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#propertyCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">{{ 'property.carousel_prev'|trans }}</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#propertyCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">{{ 'property.carousel_next'|trans }}</span>
                    </button>
                </div>
                {% else %}
                <div class="bg-secondary bg-opacity-10 rounded-4 d-flex align-items-center justify-content-center mb-5 hover-lift" style="aspect-ratio: 16/9;">
                    <span class="text-muted">{{ 'property.image_carousel'|trans }}</span>
                </div>
                {% endif %}

                <div class="mb-5 reveal">
                    <h2 class="h4 fw-bold mb-3">{{ 'property.about_title'|trans }}</h2>
                    {% if locale == 'en' and property.aboutEn %}
                        <p class="text-dark lh-lg" style="white-space: pre-line;">{{ property.aboutEn }}</p>
                    {% else %}
                        <p class="text-dark lh-lg" style="white-space: pre-line;">{{ property.about ?? property.description ?? 'property.about_default'|trans }}</p>
                    {% endif %}
                </div>

                <div class="mb-5 reveal">
                    <h2 class="h4 fw-bold mb-3">{{ 'property.accommodation_title'|trans }}</h2>
                    {% if locale == 'en' and property.accommodationEn %}
                        <p class="text-dark lh-lg" style="white-space: pre-line;">{{ property.accommodationEn }}</p>
                    {% else %}
                        <p class="text-dark lh-lg" style="white-space: pre-line;">{{ property.accommodation ?? 'property.accommodation_default'|trans }}</p>
                    {% endif %}
                </div>

                <div class="mb-5 reveal">
                    <h2 class="h4 fw-bold mb-3">{{ 'property.guest_access_title'|trans }}</h2>
                    {% if locale == 'en' and property.guestAccessEn %}
                        <p class="text-dark lh-lg" style="white-space: pre-line;">{{ property.guestAccessEn }}</p>
                    {% else %}
                        <p class="text-dark lh-lg" style="white-space: pre-line;">{{ property.guestAccess ?? 'property.guest_access_default'|trans }}</p>
                    {% endif %}
                </div>

                {% set otherRemarks = locale == 'en' and property.otherRemarksEn ? property.otherRemarksEn : property.otherRemarks %}
                {% if otherRemarks %}
                <div class="mb-5 reveal">
                    <h2 class="h4 fw-bold mb-3">{{ 'property.other_remarks_title'|trans }}</h2>
                    <p class="text-dark lh-lg" style="white-space: pre-line;">{{ otherRemarks }}</p>
                </div>
                {% endif %}

                <div class="mb-5 reveal" id="availability">
                    {# <h2 class="h4 fw-bold mb-2">{{ 'property.availability_title'|trans }}</h2>
                    <p class="text-muted small mb-3">{{ 'property.availability_intro'|trans }}</p> #}

                    {# {% if availability.nextAvailable is defined and availability.nextAvailable %}
                        <div class="alert alert-success d-flex align-items-center gap-2 mb-3">
                            <span class="fw-semibold text-teal">{{ 'property.availability_next'|trans({'%date%': availability.nextAvailable|date('d M Y')}) }}</span>
                        </div>
                    {% endif %}

                    {% if availability.booked is defined and availability.booked|length > 0 %}
                        <div class="list-group">
                            <div class="list-group-item border-0 px-0 fw-semibold text-muted small">{{ 'property.availability_booked'|trans }}</div>
                            {% for range in availability.booked %}
                                <div class="list-group-item border-0 px-0 d-flex justify-content-between align-items-center">
                                    <span>{{ range.start|date('d M Y') }} - {{ range.end|date('d M Y') }}</span>
                                    <span class="badge bg-light text-teal border border-teal-subtle">{{ 'property.occupied'|trans }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="alert alert-light border text-muted small mb-0">
                            {{ 'property.availability_all_open'|trans }}
                        </div>
                    {% endif %} #}

                    {# <div class="alert alert-info border-0 bg-info bg-opacity-10 text-muted small mt-3 mb-0">
                        {{ 'property.availability_note'|trans({'%source%': availability.source|default('demo')}) }}
                    </div> #}
                </div>
            </div>

            <div class="col-lg-4 reveal" style="transition-delay: 0.2s;">
                <div class="card border-0 shadow-sm mb-4 hover-lift">
                    <div class="card-body p-4">
                        <h3 class="h5 fw-bold mb-3">{{ 'property.popular_amenities'|trans }}</h3>
                        <div class="d-flex flex-wrap gap-3">
                            {% for amenity in property.amenities %}
                                <span class="amenity-icon text-teal" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ amenity.name }}">
                                    {{ amenity.icon|raw }}
                                </span>
                            {% else %}
                                <span class="text-muted small">{{ 'property.amenities_coming'|trans }}</span>
                            {% endfor %}
                        </div>
                    </div>
                </div>
                <div class="card border-0 shadow-sm hover-lift">
                    <div class="card-body p-4">
                        <h3 class="h5 fw-bold mb-3">{{ 'property.location'|trans }}</h3>
                        <div class="rounded-3 overflow-hidden" style="aspect-ratio: 4/3;">
                            <iframe 
                                width="100%" 
                                height="100%" 
                                frameborder="0" 
                                style="border:0" 
                                src="https://www.google.com/maps?q={{ property.city|url_encode }}&t=&z=13&ie=UTF8&iwloc=&output=embed" 
                                allowfullscreen>
                            </iframe>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if property.slug == 'lambersart' %}
        <script src="https://login.smoobu.com/js/Settings/BookingToolIframe.js"></script>
        <script>
            const initSmoobuIframe = () => {
                if (window.BookingToolIframe && document.querySelector('#apartmentIframeAll')) {
                    BookingToolIframe.initialize({
                        url: 'https://login.smoobu.com/fr/booking-tool/iframe/1213908',
                        baseUrl: 'https://login.smoobu.com/',
                        target: '#apartmentIframeAll'
                    });
                }
            };

            document.addEventListener('DOMContentLoaded', initSmoobuIframe);
            document.addEventListener('turbo:load', initSmoobuIframe);
        </script>
    {% endif %}
{% endblock %}
