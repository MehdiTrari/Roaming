{% extends 'base.html.twig' %}

{% block title %}{{ property.title }} | Roaming Lille{% endblock %}

{% block meta_description %}{% if property.bedrooms > 0 %}{{ 'seo.property_description'|trans({'%title%': property.title, '%city%': property.city, '%bedrooms%': property.bedrooms, '%beds%': property.beds, '%bathrooms%': property.bathrooms, '%travelers%': property.travelers}) }}{% else %}{{ property.title }} - {{ property.city }}{% endif %}{% endblock %}

{% block meta_keywords %}{{ property.title }}, {{ property.city }}, location appartement {{ property.city }}, hébergement {{ property.city }}, Roaming Lille{% endblock %}

{% block og_type %}product{% endblock %}

{% block og_image %}{% if property.images|length > 0 %}{{ absolute_url(asset('uploads/' ~ property.images|first.filename)) }}{% else %}{{ parent() }}{% endif %}{% endblock %}
{% block og_dimensions %}
{% if property.images|length > 0 %}
    {% set optimized = responsive_image((property.images|first).filename) %}
    {% if optimized %}<meta property="og:image:width" content="{{ optimized.width }}"><meta property="og:image:height" content="{{ optimized.height }}">{% endif %}
{% else %}{{ parent() }}{% endif %}
{% endblock %}

{% block structured_data %}
{{ parent() }}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "LodgingBusiness",
    "name": {{ property.title|json_encode(15)|raw }},
    "description": {{ property.about|default(property.description)|default('')|slice(0, 200)|json_encode(15)|raw }},
    "url": {{ url('app_property_show', {slug: property.slug})|json_encode(15)|raw }},
    {% if property.images|length > 0 %}
    "image": [
        {% for image in property.images|slice(0, 5) %}
        {{ absolute_url(asset('uploads/' ~ image.filename))|json_encode(15)|raw }}{% if not loop.last %},{% endif %}
        {% endfor %}
    ],
    {% endif %}
    "address": {
        "@type": "PostalAddress",
        "addressLocality": {{ property.city|json_encode(15)|raw }},
        "addressRegion": "Hauts-de-France",
        "addressCountry": "FR"
    },
    {% if property.bedrooms > 0 %}"numberOfRooms": {{ property.bedrooms }},{% endif %}
    "occupancy": {
        "@type": "QuantitativeValue",
        "maxValue": {{ property.travelers }}
    },
    "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+33660344071",
        "email": "contact@roamingfr.com",
        "contactType": "reservations"
    }{% if property.airbnbRating and property.airbnbReviewsCount %},
    "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": {{ property.airbnbRating|json_encode(15)|raw }},
        "bestRating": "5",
        "worstRating": "1",
        "ratingCount": {{ property.airbnbReviewsCount|json_encode(15)|raw }},
        "reviewCount": {{ property.airbnbReviewsCount|json_encode(15)|raw }}
    }{% endif %}
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": {{ 'menu.home'|trans|json_encode(15)|raw }},
            "item": {{ url('app_home')|json_encode(15)|raw }}
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": {{ 'menu.properties'|trans|json_encode(15)|raw }},
            "item": {{ (url('app_home') ~ '#featured')|json_encode(15)|raw }}
        },
        {
            "@type": "ListItem",
            "position": 3,
            "name": {{ property.title|json_encode(15)|raw }},
            "item": {{ url('app_property_show', {slug: property.slug})|json_encode(15)|raw }}
        }
    ]
}
</script>
{% endblock %}

{% block body %}
{% set locale = app.request.locale %}
{% set about = locale == 'en' and property.aboutEn ? property.aboutEn : (property.about ?: property.description) %}
{% set accommodation = locale == 'en' and property.accommodationEn ? property.accommodationEn : property.accommodation %}
{% set guestAccess = locale == 'en' and property.guestAccessEn ? property.guestAccessEn : property.guestAccess %}
{% set remarks = locale == 'en' and property.otherRemarksEn ? property.otherRemarksEn : property.otherRemarks %}
<article class="property-page">
    <div class="container">
        <nav class="property-breadcrumb" aria-label="{{ 'listing.breadcrumb'|trans }}">
            <a href="{{ path('app_home') }}">{{ 'menu.home'|trans }}</a><span aria-hidden="true">/</span>
            <a href="{{ path('app_home') }}#featured">{{ 'menu.properties'|trans }}</a><span aria-hidden="true">/</span>
            <span aria-current="page">{{ property.city }}</span>
        </nav>
        <header class="property-heading">
            <div><p class="calendar-eyebrow">{{ property.city }} · {{ 'listing.region'|trans }}</p><h1>{{ property.title }}</h1></div>
            <a class="btn btn-primary" href="#availability">{{ 'calendar.choose'|trans }}</a>
        </header>
        {% include 'components/_property_facts.html.twig' with {property: property} only %}

        {% if property.images|length > 0 %}
            <section id="propertyGallery" class="carousel slide property-gallery" {% if property.images|length > 1 %}data-controller="property-gallery"{% endif %} aria-label="{{ 'listing.photos_of'|trans({'%name%': property.title}) }}" aria-roledescription="{{ 'property.image_carousel'|trans }}" tabindex="0">
                <div class="property-gallery-layout">
                <div class="carousel-inner property-gallery-main">
                    {% for image in property.images %}
                        <div class="carousel-item {{ loop.first ? 'active' : '' }} h-100" role="group" aria-label="{{ 'listing.photo_position'|trans({'%index%': loop.index, '%total%': property.images|length}) }}">
                            {% include 'components/_picture.html.twig' with {filename: image.filename, imageClass: 'd-block w-100 h-100 object-fit-cover', alt: image.alt ?: property.title, sizes: '(min-width: 1600px) 960px, (min-width: 992px) 62vw, 100vw', priority: loop.first} only %}
                        </div>
                    {% endfor %}
                </div>
                {% if property.images|length > 1 %}
                <div class="property-gallery-peeks">
                    {% for image in property.images|slice(1, 2) %}
                    <button type="button" data-bs-target="#propertyGallery" data-bs-slide-to="{{ loop.index }}" aria-label="{{ 'listing.photo_position'|trans({'%index%': loop.index + 1, '%total%': property.images|length}) }}">
                        {% include 'components/_picture.html.twig' with {filename: image.filename, imageClass: '', alt: '', sizes: '(min-width: 992px) 30vw, 1px'} only %}
                        <span aria-hidden="true">&#8599;</span>
                    </button>
                    {% endfor %}
                </div>
                {% endif %}
                </div>
                {% if property.images|length > 1 %}
                    <button class="carousel-control-prev" type="button" data-bs-target="#propertyGallery" data-bs-slide="prev"><span class="carousel-control-prev-icon" aria-hidden="true"></span><span class="visually-hidden">{{ 'property.carousel_prev'|trans }}</span></button>
                    <button class="carousel-control-next" type="button" data-bs-target="#propertyGallery" data-bs-slide="next"><span class="carousel-control-next-icon" aria-hidden="true"></span><span class="visually-hidden">{{ 'property.carousel_next'|trans }}</span></button>
                    <div class="carousel-indicators property-gallery-thumbs" aria-label="{{ 'listing.choose_photo'|trans }}">
                        {% for image in property.images %}
                            <button type="button" data-bs-target="#propertyGallery" data-bs-slide-to="{{ loop.index0 }}" class="{{ loop.first ? 'active' : '' }}" {% if loop.first %}aria-current="true"{% endif %} aria-label="{{ 'listing.photo_position'|trans({'%index%': loop.index, '%total%': property.images|length}) }}">{% include 'components/_picture.html.twig' with {filename: image.filename, alt: '', sizes: '80px', width: 80, height: 60} only %}</button>
                        {% endfor %}
                    </div>
                {% endif %}
            </section>
        {% else %}
            <div class="property-gallery-main property-photo-placeholder"><span>{{ 'calendar.photo_pending'|trans }}</span><small>{{ 'listing.no_photos'|trans }}</small></div>
        {% endif %}

        <nav class="property-section-nav" aria-label="{{ 'listing.sections'|trans }}">
            <a href="#property-details">{{ 'property.about_title'|trans }}</a><a href="#property-amenities">{{ 'property.popular_amenities'|trans }}</a><a href="#property-location">{{ 'property.location'|trans }}</a><a href="#availability">{{ 'calendar.title'|trans }}</a>
        </nav>
        <div class="property-layout">
            <div class="property-description" id="property-details">
                <section class="property-panel" aria-labelledby="property-about-heading">
                    <p class="calendar-eyebrow">{{ 'listing.your_place'|trans }}</p><h2 id="property-about-heading">{{ 'property.about_title'|trans }}</h2>
                    {% if about %}<p class="property-prose">{{ about }}</p>{% else %}<p class="property-muted">{{ 'listing.no_description'|trans }}</p>{% endif %}
                    {% if property.airbnbUrl %}<a class="airbnb-badge property-airbnb" href="{{ property.airbnbUrl starts with 'https://' or property.airbnbUrl starts with 'http://' ? property.airbnbUrl : 'https://' ~ property.airbnbUrl }}" target="_blank" rel="noopener noreferrer"><img src="{{ asset('images/Airbnb-Logo.png') }}" alt="Airbnb" height="18"><span>{{ 'property.view_on_airbnb'|trans }}</span>{% if property.airbnbRating %}<strong>★ {{ property.airbnbRating|number_format(2, locale == 'fr' ? ',' : '.') }}</strong>{% endif %}{% if property.airbnbReviewsCount %}<span>({{ property.airbnbReviewsCount }} {{ 'property.reviews'|trans }})</span>{% endif %}</a>{% endif %}
                </section>
                {% for section in [{title: 'property.accommodation_title', text: accommodation}, {title: 'property.guest_access_title', text: guestAccess}, {title: 'property.other_remarks_title', text: remarks}] %}
                    {% if section.text %}<section class="property-panel"><h2>{{ section.title|trans }}</h2><p class="property-prose">{{ section.text }}</p></section>{% endif %}
                {% endfor %}
                <section class="property-panel" id="property-amenities" aria-labelledby="property-amenities-heading">
                    <h2 id="property-amenities-heading">{{ 'property.popular_amenities'|trans }}</h2>
                    <ul class="property-amenities">
                        {% for amenity in property.amenities|display_amenities %}<li>{% if amenity.icon %}<span class="property-amenity-icon" aria-hidden="true">{{ amenity.icon|raw }}</span>{% endif %}<span>{{ amenity.name|trans }}</span></li>{% else %}<li class="property-empty-state"><p>{{ 'listing.no_amenities'|trans }}</p><a href="{{ path('app_contact') }}">{{ 'listing.ask_amenities'|trans }}</a></li>{% endfor %}
                    </ul>
                </section>
                <section class="property-panel" id="property-location" aria-labelledby="property-location-heading">
                    <h2 id="property-location-heading">{{ 'property.location'|trans }}</h2><p>{{ property.city }} · {{ 'listing.region'|trans }}</p>
                    {% include 'components/_property_map.html.twig' with {properties: [property], selectedSlug: property.slug} only %}
                </section>
            </div>
            <aside id="availability" class="property-availability" aria-labelledby="property-stay-heading">
                <div class="property-stay-intro"><p class="property-muted">{{ property.title }}</p><h2 id="property-stay-heading">{{ 'calendar.book_stay'|trans }}</h2></div>
                {% include 'calendar/_planning.html.twig' with {calendarUrl: path('api_property_availability', {slug: property.slug}), compact: true} %}
            </aside>
        </div>
        {% set otherProperties = navProperties|filter(item => item.slug != property.slug) %}
        {% if otherProperties|length > 0 %}
            <section class="property-other" aria-labelledby="property-other-heading">
                <div class="property-other-heading"><div><p class="calendar-eyebrow">{{ 'menu.properties'|trans }}</p><h2 id="property-other-heading">{{ 'listing.other_places'|trans }}</h2></div><a href="{{ path('app_home') }}#featured">{{ 'listing.back_catalogue'|trans }} <span aria-hidden="true">↗</span></a></div>
                <div class="row g-4">{% for item in otherProperties %}<div class="col-md-6">{% include 'components/_property_card.html.twig' with {property: item} only %}</div>{% endfor %}</div>
            </section>
        {% endif %}
    </div>
</article>
{% endblock %}
