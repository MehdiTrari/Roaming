<!DOCTYPE html>
<html lang="{{ app.request.locale }}" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Roaming Lille — Premium Stays{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🏠</text></svg>">
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}
</head>
<body>
    <header class="sticky-top bg-peps border-bottom">
        <nav class="navbar navbar-expand-md py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" href="{{ path('app_home') }}">
                    <img src="{{ asset('images/logo-footer-black.png') }}" alt="Roaming Lille" class="img-fluid logo-light">
                    <img src="{{ asset('images/logo-footer-white.png') }}" alt="Roaming Lille" class="img-fluid logo-dark">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 fw-medium">
                        <li class="nav-item">
                            <a class="nav-link hover-teal" href="{{ path('app_home') }}">{{ 'menu.home'|trans }}</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle hover-teal" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                {{ 'menu.properties'|trans }}
                            </a>
                            <ul class="dropdown-menu shadow-sm border-0">
                                {% for p in navProperties|default([]) %}
                                    <li><a class="dropdown-item" href="{{ path('app_property_show', {slug: p.slug}) }}">{{ p.title }}</a></li>
                                {% else %}
                                    <li><span class="dropdown-item text-muted">No properties yet</span></li>
                                {% endfor %}
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link hover-teal" href="{{ path('app_contact') }}">{{ 'menu.contact'|trans }}</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link hover-teal" href="{{ path('app_about') }}">{{ 'menu.about'|trans }}</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="theme-toggle" aria-label="Toggle theme">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-sun-fill d-none" id="icon-light" viewBox="0 0 16 16">
                                <path d="M8 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0zm0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13zm8-5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2a.5.5 0 0 1 .5.5zM3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8zm10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.415a.5.5 0 1 1-.707-.708l1.414-1.414a.5.5 0 0 1 .707 0zm-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0zm9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 0 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707zM4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .708z"/>
                            </svg>
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-moon-fill" id="icon-dark" viewBox="0 0 16 16">
                                <path d="M6 .278a.768.768 0 0 1 .08.858 7.208 7.208 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277.527 0 1.04-.055 1.533-.16a.787.787 0 0 1 .81.316.733.733 0 0 1-.031.893A8.349 8.349 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.752.752 0 0 1 6 .278z"/>
                            </svg>
                        </button>
                        <div class="btn-group btn-group-sm" role="group">
                            <a href="{{ path('app_switch_locale', {'locale': 'en'}) }}" class="btn btn-outline-secondary {{ app.request.locale == 'en' ? 'active' : '' }}">EN</a>
                            <a href="{{ path('app_switch_locale', {'locale': 'fr'}) }}" class="btn btn-outline-secondary {{ app.request.locale == 'fr' ? 'active' : '' }}">FR</a>
                        </div>
                        <a href="{{ path('app_home') }}#top" class="btn btn-primary fw-semibold text-white px-4">{{ 'menu.book_now'|trans }}</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        {% for label, messages in app.flashes %}
            <div class="container pt-4">
                {% for message in messages %}
                    <div class="alert alert-success d-flex align-items-center" role="alert">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-check-circle-fill me-2" viewBox="0 0 16 16">
                          <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                        </svg>
                        <div>{{ message }}</div>
                    </div>
                {% endfor %}
            </div>
        {% endfor %}
        {% block body %}{% endblock %}
    </main>

    <footer class="mt-4 py-4 bg-peps">
        <div class="container">
            <div class="row gy-3">
                <div class="col-md-6">
                    <img src="{{ asset('images/logo-footer-black.png') }}" alt="Roaming Lille" class="mb-2 logo-light" style="height: 40px;">
                    <img src="{{ asset('images/logo-footer-white.png') }}" alt="Roaming Lille" class="mb-2 logo-dark" style="height: 40px;">
                    <p class="text-muted small w-75 mb-0">{{ 'footer.description'|trans }}</p>
                </div>
                <div class="col-md-3">
                    <h6 class="fw-bold mb-2">{{ 'footer.quick_links'|trans }}</h6>
                    <ul class="list-unstyled text-muted small mb-0">
                        <li class="mb-1"><a href="{{ path('app_home') }}" class="text-decoration-none text-muted hover-teal">{{ 'menu.home'|trans }}</a></li>
                        <li class="mb-1"><a href="{{ path('app_about') }}" class="text-decoration-none text-muted hover-teal">{{ 'menu.about'|trans }}</a></li>
                        <li class="mb-1"><a href="{{ path('app_contact') }}" class="text-decoration-none text-muted hover-teal">{{ 'menu.contact'|trans }}</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h6 class="fw-bold mb-2">{{ 'footer.contact'|trans }}</h6>
                    <ul class="list-unstyled text-muted small mb-0">
                        <li class="mb-1 d-flex align-items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-envelope" viewBox="0 0 16 16">
                              <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-4.708 2.825L15 11.105V5.383Zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741ZM1 11.105l4.708-2.897L1 5.383v5.722Z"/>
                            </svg>
                            <a href="mailto:contact@roamingfr.com" class="text-decoration-none text-muted hover-teal">contact@roamingfr.com</a>
                        </li>
                        <li class="mb-1 d-flex align-items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-telephone" viewBox="0 0 16 16">
                              <path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.568 17.568 0 0 0 4.168 6.608 17.569 17.569 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.678.678 0 0 0-.58-.122l-2.19.547a1.745 1.745 0 0 1-1.657-.459L5.482 8.062a1.745 1.745 0 0 1-.46-1.657l.548-2.19a.678.678 0 0 0-.122-.58L3.654 1.328zM1.884.511a1.745 1.745 0 0 1 2.612.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.678.678 0 0 0 .178.643l2.457 2.457a.678.678 0 0 0 .644.178l2.189-.547a1.745 1.745 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.634 18.634 0 0 1-7.01-4.42 18.634 18.634 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877L1.885.511z"/>
                            </svg>
                            <a href="tel:+33660344071" class="text-decoration-none text-muted hover-teal">+33 6 60 34 40 71</a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="border-top pt-3 mt-3 d-flex flex-column flex-md-row justify-content-between align-items-center small text-muted">
                <p class="mb-0">&copy; {{ 'now'|date('Y') }} Roaming Lille. {{ 'footer.rights'|trans }}</p>
                <div class="d-flex gap-3">
                    <a href="#" class="text-decoration-none text-muted">{{ 'footer.privacy'|trans }}</a>
                    <a href="#" class="text-decoration-none text-muted">{{ 'footer.terms'|trans }}</a>
                </div>
            </div>
        </div>
    </footer>
</div>
</body>
    <script>
        // If arriving with #top fragment, ensure a smooth scroll to top and remove the hash.
        document.addEventListener('DOMContentLoaded', function () {
            try {
                if (window.location.hash === '#top') {
                    setTimeout(function () {
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                        history.replaceState(null, '', window.location.pathname + window.location.search);
                    }, 50);
                }
            } catch (e) {}
        });
    </script>
</html>
