{% extends 'base.html.twig' %}

{% block title %}{{ 'home.title'|trans }}{% endblock %}

{% block meta_description %}{{ 'seo.home_description'|trans }}{% endblock %}

{% block structured_data %}
{{ parent() }}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Roaming Lille",
    "url": {{ url('app_home')|json_encode(15)|raw }}
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "ItemList",
    "itemListElement": [
        {% for property in featuredProperties %}
        {
            "@type": "ListItem",
            "position": {{ loop.index }},
            "item": {
                "@type": "LodgingBusiness",
                "name": {{ property.title|json_encode(15)|raw }},
                "url": {{ url('app_property_show', {slug: property.slug})|json_encode(15)|raw }},
                "address": {
                    "@type": "PostalAddress",
                    "addressLocality": {{ property.city|json_encode(15)|raw }},
                    "addressCountry": "FR"
                }
            }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
{% endblock %}

{% block body %}
{% set heroProperty = null %}
{% for property in featuredProperties %}
    {% if heroProperty is null and property.images|length > 0 %}{% set heroProperty = property %}{% endif %}
{% endfor %}
<div class="roaming-home">
<section class="hero-section home-hero" aria-labelledby="home-heading">
    {% if heroProperty %}
        {% include 'components/_picture.html.twig' with {filename: heroProperty.images[0].filename, imageClass: 'home-hero-image', alt: '', sizes: '100vw', priority: true} only %}
    {% endif %}
    <div class="home-hero-shade"></div>
    <div class="container position-relative">
        <div class="home-hero-copy">
            <p class="home-eyebrow">{{ 'home.hero_badge'|trans }}</p>
            <h1 id="home-heading">{{ 'home.hero_title'|trans }}</h1>
            <p class="lead">{{ 'home.hero_description'|trans }}</p>
            <a class="btn btn-primary" href="#featured">{{ 'home.browse_properties'|trans }}</a>
            {% if heroProperty %}<a class="home-hero-caption" href="{{ path('app_property_show', {slug: heroProperty.slug}) }}">{{ heroProperty.title }} · {{ heroProperty.city }} <span aria-hidden="true">↗</span></a>{% endif %}
        </div>
        
        <div class="row justify-content-center reveal" style="transition-delay: 0.2s;">
            <div class="col-xl-10">
                <div class="booking-bar shadow-sm p-2 position-relative z-2">
                    <div id="booking-guide" class="booking-guide" hidden>
                        <div class="booking-guide-heading"><p>{{ 'showcase.guide_title'|trans }} <strong id="booking-guide-property"></strong></p><button type="button" id="booking-guide-close" aria-label="{{ 'showcase.exit_guide'|trans }}">×</button></div>
                        <ol class="booking-guide-steps" aria-label="{{ 'showcase.guide_steps'|trans }}"><li data-guide-step="1"><span>1</span>{{ 'calendar.property'|trans }}</li><li data-guide-step="2"><span>2</span>{{ 'ui.stay_dates'|trans }}</li><li data-guide-step="3"><span>3</span>{{ 'home.guests'|trans }}</li><li data-guide-step="4"><span>4</span>{{ 'home.search'|trans }}</li></ol>
                    </div>
                    <form id="booking-search-form" data-calendar-url="{{ path('api_calendar') }}" data-availability-enabled="{{ booking_availability_enabled ? 'true' : 'false' }}" class="d-flex flex-column flex-lg-row align-items-stretch align-items-lg-center">
                        
                        <!-- Property -->
                        <div class="booking-field-horizontal flex-grow-1 position-relative px-4 py-2 border-end-lg" id="property-toggle">
                            <span id="property-label" class="small fw-bold text-muted d-block mb-1">{{ 'calendar.property'|trans }}</span>
                            <button type="button" id="property-display" class="booking-selector property-selector" aria-haspopup="dialog" aria-expanded="false" aria-controls="property-panel" aria-labelledby="property-label property-display-text">
                                <span id="property-display-text">{{ 'journey.all_properties'|trans }}</span>
                            </button>
                            <select id="booking-property" class="d-none" name="slug" tabindex="-1" aria-hidden="true">
                                <option value="">{{ 'journey.all_properties'|trans }}</option>
                                {% for item in featuredProperties %}<option value="{{ item.slug }}" data-capacity="{{ item.travelers }}" data-calendar-url="{{ path('api_property_availability', {slug: item.slug}) }}">{{ item.city }}</option>{% endfor %}
                            </select>
                            <dialog id="property-panel" class="selector-panel home-search-popover property-search-popover d-none" aria-labelledby="property-panel-title">
                                <div class="search-popover-heading"><h5 id="property-panel-title">{{ 'calendar.property'|trans }}</h5><button type="button" class="search-popover-close" data-search-dismiss aria-label="{{ 'ui.close'|trans }}">×</button></div>
                                <p class="booking-guide-panel-hint" data-guide-hint="property" hidden>{{ 'showcase.guide_property'|trans }}</p>
                                <div class="property-search-options">
                                    <button type="button" data-property-option="" aria-pressed="false">{{ 'journey.all_properties'|trans }}</button>
                                    {% for item in featuredProperties %}<button type="button" data-property-option="{{ item.slug }}" aria-pressed="false">{{ item.city }}</button>{% endfor %}
                                </div>
                            </dialog>
                        </div>

                        <!-- Dates -->
                        <div class="booking-field-horizontal flex-grow-1 position-relative px-4 py-2 border-end-lg" id="date-toggle" data-open="false">
                            <span id="date-label" class="small fw-bold text-muted d-block mb-1">{{ 'home.arrival_date'|trans }} - {{ 'home.departure_date'|trans }}</span>
                            <button type="button" class="booking-selector d-flex align-items-center" id="date-display" aria-haspopup="dialog" aria-expanded="false" aria-controls="date-panel" aria-labelledby="date-label date-display-text">
                                <span class="me-2 text-teal">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-calendar-event" viewBox="0 0 16 16">
                                        <path d="M11 6.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1z"/>
                                        <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z"/>
                                    </svg>
                                </span>
                                <div class="text-truncate fw-bold text-dark" id="date-display-text">
                                    <span class="selector-title">{{ 'ui.choose_dates'|trans }}</span>
                                    <span class="selector-sub d-none">{{ 'ui.choose_dates'|trans }}</span>
                                </div>
                            </button>
                            
                            <!-- Hidden Panel -->
                            <dialog class="selector-panel home-search-popover d-none" id="date-panel" aria-labelledby="date-panel-title">
                                <div class="search-popover-heading"><h5 id="date-panel-title">{{ 'ui.stay_dates'|trans }}</h5><button type="button" class="search-popover-close" data-search-dismiss aria-label="{{ 'ui.close'|trans }}">×</button></div>
                                <p class="booking-guide-panel-hint" data-guide-hint="dates" hidden>{{ 'showcase.guide_dates'|trans }}</p>
                                <p class="small text-muted mb-2">{{ 'ui.date_hint'|trans }}</p>
                                <p id="date-availability-status" class="small search-calendar-status" role="status" aria-live="polite"></p>
                                <div id="date-calendar-surface" class="calendar-fetch-surface">
                                    <div id="date-calendar" class="date-calendar"></div>
                                    {% include 'components/_calendar_loading.html.twig' only %}
                                </div>
                                <input type="text" id="date-range" class="visually-hidden" aria-label="{{ 'ui.stay_dates'|trans }}" tabindex="-1">
                                <input type="hidden" id="arrival-date">
                                <input type="hidden" id="departure-date">
                                <p class="stay-legend search-calendar-legend"><span>{{ 'calendar.available'|trans }}</span><s>{{ 'calendar.unavailable'|trans }}</s><span>? {{ 'calendar.unverified'|trans }}</span><span>↗ {{ 'calendar.checkout_only'|trans }}</span></p>
                                <a id="date-calendar-contact" class="calendar-contact" href="{{ path('app_contact') }}" hidden>{{ 'calendar.contact'|trans }} →</a>
                                <div class="panel-actions">
                                    {% include 'components/_clear_dates.html.twig' with {id: 'date-cancel'} only %}
                                    <button type="button" class="btn btn-primary btn-sm text-white" id="date-apply">{{ 'ui.apply'|trans }}</button>
                                </div>
                            </dialog>
                        </div>

                        <!-- Guests -->
                        <div class="booking-field-horizontal flex-grow-1 position-relative px-4 py-2" id="guests-toggle" data-open="false">
                            <span id="guests-label" class="small fw-bold text-muted d-block mb-1">{{ 'home.guests'|trans }}</span>
                            <button type="button" class="booking-selector d-flex align-items-center" id="guests-display" aria-haspopup="dialog" aria-expanded="false" aria-controls="guests-panel" aria-labelledby="guests-label guests-display-text">
                                <span class="me-2 text-teal">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-people-fill" viewBox="0 0 16 16">
                                        <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1H7zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
                                        <path fill-rule="evenodd" d="M5.216 14A2.238 2.238 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.325 6.325 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1h4.216z"/>
                                        <path d="M4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"/>
                                    </svg>
                                </span>
                                <div class="fw-bold text-dark" id="guests-display-text">
                                    <span class="selector-title">{{ 'ui.one_guest'|trans }}</span>
                                    <span class="selector-sub d-none">{{ 'home.guests'|trans }}</span>
                                </div>
                            </button>

                            <!-- Hidden Panel -->
                            <dialog class="selector-panel home-search-popover d-none" id="guests-panel" aria-labelledby="guests-panel-title">
                                <div class="search-popover-heading"><h5 id="guests-panel-title">{{ 'home.guests'|trans }}</h5><button type="button" class="search-popover-close" data-search-dismiss aria-label="{{ 'ui.close'|trans }}">×</button></div>
                                <p class="booking-guide-panel-hint" data-guide-hint="guests" hidden>{{ 'showcase.guide_guests'|trans }}</p>
                                <div class="guests-body">
                                    <div class="guests-labels">
                                        <span class="hint">{{ 'ui.guest_hint'|trans }}</span>
                                    </div>
                                    <div class="guests-counter">
                                        <button type="button" id="guests-decrease" aria-label="{{ 'ui.fewer_guests'|trans }}">-</button>
                                        <input type="text" id="guests-current" value="1" readonly aria-label="{{ 'home.guests'|trans }}">
                                        <button type="button" id="guests-increase" aria-label="{{ 'ui.more_guests'|trans }}">+</button>
                                    </div>
                                </div>
                                <div class="panel-actions"><button type="button" class="btn btn-primary btn-sm text-white" data-search-dismiss id="guests-apply">{{ 'ui.apply'|trans }}</button></div>
                            </dialog>
                            <select class="form-select d-none" id="guests-count" aria-label="{{ 'home.guests'|trans }}">
                                {% set maxGuests = 1 %}
                                {% for property in featuredProperties %}{% set maxGuests = max(maxGuests, property.travelers) %}{% endfor %}
                                {% for count in 1..maxGuests %}<option value="{{ count }}">{{ count }}</option>{% endfor %}
                            </select>
                        </div>

                        <!-- Submit -->
                        <div class="p-1">
                            <button type="submit" class="btn btn-primary rounded-pill px-4 py-3 fw-bold h-100 w-100 d-flex align-items-center justify-content-center gap-2 hover-lift booking-submit">
                                <span>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                                    </svg>
                                </span>
                                <span>{{ 'home.search'|trans }}</span>
                            </button>
                        </div>
                    </form>
                </div>
                <p id="booking-search-status" class="booking-search-status" role="status" aria-live="polite"></p>
                
                <!-- Search Results -->
                <div id="booking-results" class="mt-5 d-none">
                    <div class="card border-0 shadow-lg p-4">
                        <div id="results-list" role="status" aria-live="polite" aria-atomic="true" class="d-flex flex-column gap-2"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="bg-light py-5" id="featured">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-end mb-5 flex-wrap gap-3 reveal">
            <div>
                <p class="text-teal fw-bold mb-2">{{ 'home.featured_properties'|trans }}</p>
                <h2 class="h2 fw-bold mb-0">{{ 'home.featured_subtitle'|trans }}</h2>
            </div>
            <a href="{{ path('app_calendar') }}" class="text-teal text-decoration-none fw-bold hover-lift">{{ 'calendar.title'|trans }}</a>
        </div>
        {% include 'home/_property_showcase.html.twig' %}
    </div>
</section>

<section class="py-5" id="amenities">
    <div class="container py-4">
        <div class="mb-5 reveal">
            <p class="text-teal fw-bold mb-2">{{ 'home.popular_amenities'|trans }}</p>
            <h2 class="h2 fw-bold">{{ 'home.amenities_subtitle'|trans }}</h2>
        </div>
        <div class="row g-4 reveal-group">
            {% for amenity in popularAmenities %}
                <div class="col-md-6 col-lg-4 reveal">
                    <div class="card h-100 border-0 shadow-sm hover-lift transition-all">
                        <div class="card-body d-flex align-items-start gap-3">
                            <span class="icon-box bg-light text-teal rounded-circle">
                                {% include 'components/_amenity_icon.html.twig' with {amenity: amenity} only %}
                            </span>
                            <div>
                                <p class="fw-bold mb-1">{{ amenity|trans }}</p>
                                <p class="text-muted small mb-0">{{ 'home.amenity_verified'|trans }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

<section class="py-5" id="contact">
    <div class="container py-4">
        <div class="row gy-5">
            <div class="col-lg-6 reveal">
                <p class="text-teal fw-bold mb-2">{{ 'home.contact_title'|trans }}</p>
                <h2 class="h2 fw-bold mb-3">{{ 'home.contact_subtitle'|trans }}</h2>
                <p class="text-muted mb-4">{{ 'home.contact_description'|trans({'%email%': '<a class="text-teal text-decoration-none" href="mailto:contact@roamingfr.com">contact@roamingfr.com</a>', '%phone%': '<a class="text-teal text-decoration-none" href="tel:+33660344071">+33 6 60 34 40 71</a>'})|raw }}</p>
            </div>
            <div class="col-lg-6 reveal" style="transition-delay: 0.2s;">
                <div class="card border-0 shadow-sm p-4 hover-lift">
                    <div class="card-body">
                        {% include 'components/_contact_form.html.twig' %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
</div>
{% endblock %}
