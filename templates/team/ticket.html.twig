{% extends 'team/layout.html.twig' %}
{% block title %}#{{ ticket.id }} · {{ ticket.title }}{% endblock %}
{% block body %}
<a href="{{ path('team_tickets') }}">← {{ 'team.tickets'|trans }}</a>
<article class="team-panel team-panel-wide mt-3">
<h1>#{{ ticket.id }} · {{ ticket.title }}</h1>
<div class="ticket-card-badges mb-3">{% include 'team/_badge.html.twig' with {kind: 'status', value: ticket.status} %}{% include 'team/_badge.html.twig' with {kind: 'category', value: ticket.category} %}{% include 'team/_badge.html.twig' with {kind: 'priority', value: ticket.priority} %}{% for label in ticket.labels %}<span class="ticket-label"># {{ label }}</span>{% endfor %}</div>
<p>{{ ticket.author.name }} · {{ ticket.createdAt|date('d/m/Y H:i', 'Europe/Paris') }}</p>
<h2 class="h5">{{ 'team.description'|trans }}</h2><p class="team-prewrap">{{ ticket.description }}</p>
{% if ticket.steps %}<h2 class="h5">{{ 'team.steps'|trans }}</h2><p class="team-prewrap">{{ ticket.steps }}</p>{% endif %}
{% if ticket.expected %}<h2 class="h5">{{ 'team.expected'|trans }}</h2><p class="team-prewrap">{{ ticket.expected }}</p>{% endif %}
<p>{{ 'team.page'|trans }} : <a href="{{ ticket.page }}">{{ ticket.page }}</a></p><p class="small team-prewrap">{{ ticket.browser }} · {{ ticket.screen }}</p>
{% if ticket.attachment %}<a href="{{ path('team_ticket_capture', {id: ticket.id}) }}" target="_blank" rel="noopener">{{ 'team.view_capture'|trans }}</a>{% endif %}
</article>
{% if is_granted('ROLE_ADMIN') %}
<form method="post" class="team-panel team-panel-wide mt-3 d-flex flex-wrap gap-3" data-turbo="false">
<input type="hidden" name="_token" value="{{ csrf_token('ticket_' ~ ticket.id) }}"><input type="hidden" name="action" value="manage">
<div><label for="status">{{ 'team.status'|trans }}</label><select class="form-select" id="status" name="status">{% for status in statuses %}<option value="{{ status }}" {{ ticket.status == status ? 'selected' : '' }}>{{ ('team.status_' ~ status)|trans }}</option>{% endfor %}</select></div>
<div><label for="priority">{{ 'team.priority'|trans }}</label><select class="form-select" id="priority" name="priority">{% for priority in priorities %}<option value="{{ priority }}" {{ ticket.priority == priority ? 'selected' : '' }}>{{ ('team.priority_' ~ priority)|trans }}</option>{% endfor %}</select></div>
<div class="ticket-edit-labels"><label for="ticket-labels">{{ 'team.labels'|trans }}</label><input id="ticket-labels" class="form-control" name="labels" value="{{ ticket.labels|join(', ') }}" maxlength="270" aria-describedby="ticket-labels-help"><small id="ticket-labels-help">{{ 'team.labels_help'|trans }}</small></div>
<button class="btn btn-primary align-self-end">{{ 'team.save'|trans }}</button></form>
{% if error == 'team.labels_invalid' %}<p class="alert alert-danger" role="alert">{{ error|trans }}</p>{% endif %}
{% endif %}
<section class="team-panel team-panel-wide mt-3"><h2>{{ 'team.comments'|trans }}</h2>
{% for comment in comments %}<article class="border-bottom py-3"><p><strong>{{ comment.author.name }}</strong> · {{ comment.createdAt|date('d/m/Y H:i', 'Europe/Paris') }}</p><p class="team-prewrap">{{ comment.body }}</p></article>{% endfor %}
{% if error and error != 'team.labels_invalid' %}<p class="alert alert-danger" role="alert">{{ error|trans }}</p>{% endif %}
<form method="post" class="mt-3" data-turbo="false"><input type="hidden" name="_token" value="{{ csrf_token('ticket_' ~ ticket.id) }}"><label for="comment">{{ 'team.add_comment'|trans }}</label><textarea class="form-control mb-3" id="comment" name="comment" maxlength="10000" required></textarea><button class="btn btn-primary">{{ 'team.send'|trans }}</button></form>
</section>
{% endblock %}
