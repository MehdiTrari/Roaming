{% extends 'base.html.twig' %}

{% macro amenity_icon(amenity) %}
    {% include 'components/_amenity_icon.html.twig' with {amenity: amenity} only %}
{% endmacro %}

{% import _self as about %}

{% block title %}{{ 'about.title'|trans }}{% endblock %}

{% block meta_description %}{{ 'seo.about_description'|trans }}{% endblock %}

{% block structured_data %}
{{ parent() }}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": {{ 'about.title'|trans|json_encode(15)|raw }},
    "description": {{ 'seo.about_description'|trans|json_encode(15)|raw }},
    "url": {{ url('app_about')|json_encode(15)|raw }},
    "mainEntity": {
        "@type": "Organization",
        "name": "Roaming Lille",
        "founder": {
            "@type": "Person",
            "name": "Nizar Trabelsi"
        }
    }
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": {{ 'menu.home'|trans|json_encode(15)|raw }},
            "item": {{ url('app_home')|json_encode(15)|raw }}
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": {{ 'about.section_title'|trans|json_encode(15)|raw }},
            "item": {{ url('app_about')|json_encode(15)|raw }}
        }
    ]
}
</script>
{% endblock %}

{% block body %}
{% set nizar_linkedin %}<a href="https://www.linkedin.com/in/nizar-trabelsi-bb65161a2/" target="_blank" rel="noopener noreferrer" class="text-white text-decoration-none" title="LinkedIn" style="border-bottom: 1px solid rgba(13, 148, 136, 0.5);">Nizar Trabelsi <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#0d9488" viewBox="0 0 16 16" style="vertical-align: middle; margin-left: 2px;"><path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"/></svg></a>{% endset %}
<section class="bg-dark text-white py-5">
    <div class="container py-5 reveal">
        <p class="text-teal fw-bold mb-2">{{ 'about.section_title'|trans }}</p>
        <h1 class="display-4 fw-bold mb-3">{{ 'about.hero_title'|trans }}</h1>
        <div class="lead text-light opacity-75 w-75">
            {{ 'about.hero_description'|trans|replace({'%nizar_linkedin%': nizar_linkedin})|replace({"\n": "<br>"})|raw }}
        </div>
    </div>
</section>

<section class="py-5 bg-teal-fade" id="why-choose">
    <div class="container">
        {# Header #}
        <div class="text-center mb-5 reveal">
            <h2 class="h2 fw-bold mb-3">{{ 'about.why_choose_title'|trans }}</h2>
            <p class="text-muted mb-0 mx-auto" style="max-width: 800px;">{{ 'about.why_choose_description'|trans }}</p>
        </div>

        {# Features Grid #}
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4 mb-5 reveal-group">
            <div class="col reveal">
                <div class="card h-100 border-0 shadow-sm hover-lift p-4 text-center">
                    <div class="mb-3 text-teal d-flex justify-content-center">
                        <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-teal-light" style="width: 64px; height: 64px;">
                            {{ about.amenity_icon('amenities.fast_wifi') }}
                        </span>
                    </div>
                    <p class="text-muted small mb-0">{{ 'about.feature_wifi'|trans }}</p>
                </div>
            </div>
            <div class="col reveal">
                <div class="card h-100 border-0 shadow-sm hover-lift p-4 text-center">
                    <div class="mb-3 text-teal d-flex justify-content-center">
                        <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-teal-light" style="width: 64px; height: 64px;">
                            {{ about.amenity_icon('amenities.self_checkin') }}
                        </span>
                    </div>
                    <p class="text-muted small mb-0">{{ 'about.feature_checkin'|trans }}</p>
                </div>
            </div>
            <div class="col reveal">
                <div class="card h-100 border-0 shadow-sm hover-lift p-4 text-center">
                    <div class="mb-3 text-teal d-flex justify-content-center">
                        <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-teal-light" style="width: 64px; height: 64px;">
                            {{ about.amenity_icon('amenities.equipped_accommodation') }}
                        </span>
                    </div>
                    <p class="text-muted small mb-0">{{ 'about.feature_equipped'|trans }}</p>
                </div>
            </div>
            <div class="col reveal">
                <div class="card h-100 border-0 shadow-sm hover-lift p-4 text-center">
                    <div class="mb-3 text-teal d-flex justify-content-center">
                        <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-teal-light" style="width: 64px; height: 64px;">
                            {{ about.amenity_icon('amenities.comfortable_bedding') }}
                        </span>
                    </div>
                    <p class="text-muted small mb-0">{{ 'about.feature_bedding'|trans }}</p>
                </div>
            </div>
        </div>

        {# Bottom Sections #}
        <div class="row gy-4 reveal-group">
            {# Solution Pros/Groups #}
            <div class="col-lg-4 reveal">
                <div class="card h-100 border-0 shadow-sm hover-lift">
                    <div class="card-body p-4">
                        <h3 class="h5 fw-bold mb-3 text-teal">{{ 'about.solution_pros_title'|trans }}</h3>
                        <p class="text-muted mb-0">{{ 'about.solution_pros_desc'|trans }}</p>
                    </div>
                </div>
            </div>

            {# Transparent Framework #}
            <div class="col-lg-4 reveal">
                <div class="card h-100 border-0 shadow-sm hover-lift">
                    <div class="card-body p-4">
                        <h3 class="h5 fw-bold mb-3 text-teal">{{ 'about.transparent_framework_title'|trans }}</h3>
                        <ul class="list-unstyled text-muted mb-0">
                            <li class="mb-2 d-flex align-items-start gap-2">
                                <span class="text-teal mt-1">•</span>
                                {{ 'about.transparent_framework_item1'|trans }}
                            </li>
                            <li class="mb-2 d-flex align-items-start gap-2">
                                <span class="text-teal mt-1">•</span>
                                {{ 'about.transparent_framework_item2'|trans }}
                            </li>
                            <li class="d-flex align-items-start gap-2">
                                <span class="text-teal mt-1">•</span>
                                {{ 'about.transparent_framework_item3'|trans }}
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            {# Human Management #}
            <div class="col-lg-4 reveal">
                <div class="card h-100 border-0 shadow-sm hover-lift">
                    <div class="card-body p-4">
                        <h3 class="h5 fw-bold mb-3 text-teal">{{ 'about.human_management_title'|trans }}</h3>
                        <p class="text-muted mb-0">{{ 'about.human_management_desc'|trans }}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
