{% extends 'base.html.twig' %}

{% macro amenity_icon(amenity) %}
    {% include 'components/_amenity_icon.html.twig' with {amenity: amenity} only %}
{% endmacro %}

{% import _self as about %}

{% block title %}{{ 'about.title'|trans }}{% endblock %}

{% block meta_description %}{{ 'seo.about_description'|trans }}{% endblock %}

{% block structured_data %}
{{ parent() }}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": {{ 'about.title'|trans|json_encode(15)|raw }},
    "description": {{ 'seo.about_description'|trans|json_encode(15)|raw }},
    "url": {{ url('app_about')|json_encode(15)|raw }},
    "mainEntity": {
        "@type": "Organization",
        "name": "Roaming Lille",
        "founder": {
            "@type": "Person",
            "name": "Nizar Trabelsi"
        }
    }
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": {{ 'menu.home'|trans|json_encode(15)|raw }},
            "item": {{ url('app_home')|json_encode(15)|raw }}
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": {{ 'about.section_title'|trans|json_encode(15)|raw }},
            "item": {{ url('app_about')|json_encode(15)|raw }}
        }
    ]
}
</script>
{% endblock %}

{% block body %}
{% set illustratedProperty = navProperties|default([])|filter(p => p.images|length > 0)|first %}
{% set nizar_linkedin %}<a href="https://www.linkedin.com/in/nizar-trabelsi-bb65161a2/" target="_blank" rel="noopener noreferrer" class="hospitality-founder-link" title="LinkedIn">Nizar Trabelsi <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 3h7v7M21 3 10 14M10 3H3v18h18v-7"/></svg></a>{% endset %}
<section class="hospitality-about-hero">
    <div class="container">
        <div class="hospitality-about-heading{{ illustratedProperty ? '' : ' hospitality-about-heading-text' }}">
            <div class="hospitality-about-title reveal">
                <p class="hospitality-eyebrow">{{ 'about.section_title'|trans }}</p>
                <h1 class="hospitality-page-title">{{ 'about.hero_title'|trans }}</h1>
                <a class="hospitality-editorial-link" href="{{ path('app_contact') }}">{{ 'home.contact_us'|trans }} <span aria-hidden="true">&nearr;</span></a>
            </div>
            {% if illustratedProperty %}
            <figure class="hospitality-about-photo reveal">
                {% include 'components/_picture.html.twig' with {filename: (illustratedProperty.images|first).filename, alt: '', sizes: '(min-width: 992px) 50vw, 100vw', priority: true} only %}
                <figcaption><a href="{{ path('app_property_show', {slug: illustratedProperty.slug}) }}"><span>{{ illustratedProperty.title }} <small>{{ illustratedProperty.city }}</small></span><span aria-hidden="true">&nearr;</span></a></figcaption>
            </figure>
            {% endif %}
        </div>
        <div class="hospitality-about-story reveal">
            <p>{{ 'about.hero_description'|trans|trim|replace({'%nizar_linkedin%': nizar_linkedin})|replace({"\n\n": "</p><p>", "\n": " "})|raw }}</p>
        </div>
    </div>
</section>

<section class="hospitality-about-essentials" id="why-choose">
    <div class="container">
        <div class="hospitality-section-heading reveal">
            <h2>{{ 'about.why_choose_title'|trans }}</h2>
            <p>{{ 'about.why_choose_description'|trans }}</p>
        </div>
        <div class="hospitality-essentials-grid reveal-group">
            {% for feature in [
                {icon: 'amenities.fast_wifi', copy: 'about.feature_wifi'},
                {icon: 'amenities.self_checkin', copy: 'about.feature_checkin'},
                {icon: 'amenities.equipped_accommodation', copy: 'about.feature_equipped'},
                {icon: 'amenities.comfortable_bedding', copy: 'about.feature_bedding'}
            ] %}
            <div class="hospitality-essential reveal">
                <span class="hospitality-essential-icon">{{ about.amenity_icon(feature.icon) }}</span>
                <p>{{ feature.copy|trans }}</p>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<section class="hospitality-about-principles">
    <div class="container">
        <div class="hospitality-principles-grid reveal-group">
            <article class="hospitality-principle reveal">
                <span class="hospitality-principle-number" aria-hidden="true">01</span>
                <h2>{{ 'about.solution_pros_title'|trans }}</h2>
                <p>{{ 'about.solution_pros_desc'|trans }}</p>
            </article>
            <article class="hospitality-principle reveal">
                <span class="hospitality-principle-number" aria-hidden="true">02</span>
                <h2>{{ 'about.transparent_framework_title'|trans }}</h2>
                <ul>
                    <li>{{ 'about.transparent_framework_item1'|trans }}</li>
                    <li>{{ 'about.transparent_framework_item2'|trans }}</li>
                    <li>{{ 'about.transparent_framework_item3'|trans }}</li>
                </ul>
            </article>
            <article class="hospitality-principle reveal">
                <span class="hospitality-principle-number" aria-hidden="true">03</span>
                <h2>{{ 'about.human_management_title'|trans }}</h2>
                <p>{{ 'about.human_management_desc'|trans }}</p>
            </article>
        </div>
        <div class="hospitality-about-actions reveal">
            <a class="btn btn-primary" href="{{ path('app_home', {_fragment: 'featured'}) }}">{{ 'home.browse_properties'|trans }} <span aria-hidden="true">&rarr;</span></a>
            <a class="hospitality-editorial-link" href="{{ path('app_contact') }}">{{ 'home.contact_us'|trans }} <span aria-hidden="true">&nearr;</span></a>
        </div>
    </div>
</section>
{% endblock %}
